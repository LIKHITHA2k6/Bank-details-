class BankAccount:
    def __init__(self, name, account_number, balance):
        self.name = name
        self.account_number = account_number
        self.__balance = balance

    def deposit(self, amount):
        self.__balance += amount
        print("Amount deposited:", amount)

    def withdraw(self, amount):
        if amount <= self.__balance:
            self.__balance -= amount
            print("Amount withdrawn:", amount)
        else:
            print("Insufficient balance")

    def get_balance(self):
        return self.__balance

    def calculate_interest(self):
        print("General bank account interest")


# Inheritance
class SavingsAccount(BankAccount):

    # Polymorphism
    def calculate_interest(self):
        interest = self.get_balance() * 0.04
        print("Savings Account Interest:", interest)


class CurrentAccount(BankAccount):

    # Polymorphism
    def calculate_interest(self):
        interest = self.get_balance() * 0.02
        print("Current Account Interest:", interest)


# Creating objects
savings = SavingsAccount("Likhitha", "SA101", 10000)

current = CurrentAccount("Rahul", "CA102", 20000)


# Savings Account
print("----- Savings Account -----")
print("Name:", savings.name)
print("Account Number:", savings.account_number)

savings.deposit(2000)
savings.withdraw(1000)

print("Balance:", savings.get_balance())

savings.calculate_interest()


# Current Account
print("\n----- Current Account -----")
print("Name:", current.name)
print("Account Number:", current.account_number)

current.deposit(5000)
current.withdraw(3000)

print("Balance:", current.get_balance())

current.calculate_interest()
